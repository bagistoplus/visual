includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    bootstrapFiles:
        - vendor/bagisto/bagisto/packages/Webkul/Core/src/Http/helpers.php
        - vendor/bagisto/bagisto/packages/Webkul/Theme/src/Http/helpers.php
        - vendor/bagisto/bagisto/packages/Webkul/Product/src/Http/helpers.php

    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    configDirectories:
        - config
    viewDirectories:
        - resources/views
    treatPhpDocTypesAsCertain: false
    universalObjectCratesClasses:
        - BagistoPlus\Visual\Sections\Concerns\SettingsValues
        - Webkul\Core\Contracts\Channel
    stubFiles:
        - stubs/Webkul/Theme/Theme.stub
        - stubs/Webkul/Theme/Themes.stub
        - stubs/Webkul/Core/Core.stub
        - stubs/Webkul/Core/Contracts/Channel.stub
        - stubs/Webkul/Core/Models/Locale.stub
        - stubs/Webkul/Core/Models/Channel.stub
        - stubs/Webkul/Product/Repositories/ProductRepository.stub
    ignoreErrors:
        -
            message: '#Parameter \#1 \$column of method #'
            path: src/Http/Controllers/Admin/ThemeEditorController.php
        # Larastan 3.13 checks view names against known views and cannot resolve namespaced ones such as visual:: or shop::
        -
            message: '#expects view-string, string given#'
            reportUnmatched: false
        # ProductRepository search API differs between Bagisto < 2.5 and >= 2.5; only one exists in the installed version
        -
            message: '#Call to an undefined method Webkul\\Product\\Repositories\\ProductRepository::setSearchEngine\(\)#'
            path: src/Actions/GetProducts.php
            reportUnmatched: false
        -
            message: '#Call to an undefined method Webkul\\Product\\Repositories\\ProductRepository::setSearchContext\(\)#'
            path: src/Actions/GetProducts.php
            reportUnmatched: false
        # Bagisto's section schema declares types() from 2.4.11; only one release is installed
        -
            identifier: function.alreadyNarrowedType
            path: src/Support/SectionSystem.php
            reportUnmatched: false
        # The cache profile lifetime accessor was renamed in spatie/laravel-responsecache 8; only one exists in the installed version
        -
            message: '#Call to an undefined method Spatie\\ResponseCache\\CacheProfiles\\CacheProfile::cacheRequestUntil\(\)#'
            path: src/Support/DesignModeAwareCacheProfile.php
            reportUnmatched: false
        -
            message: '#Call to an undefined method Spatie\\ResponseCache\\CacheProfiles\\CacheProfile::cacheLifetimeInSeconds\(\)#'
            path: src/Support/DesignModeAwareCacheProfile.php
            reportUnmatched: false
